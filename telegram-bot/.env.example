# Telegram Bot
APP_VERSION=2.7.0
BOT_TOKEN=your-telegram-bot-token-from-botfather
BOT_USERNAME=ResumerBot

# Resumer API
API_BASE_URL=http://web:8000/api/v1
API_TIMEOUT=30

# Redis (сессии пользователей бота)
REDIS_URL=redis://redis:6379/4

# Режим: polling | webhook
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=

# Логирование
LOG_LEVEL=INFO
