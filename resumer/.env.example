# ===========================================
# Resumer Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# --- Django Core ---
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://resumer:resumer@localhost:5432/resumer
POSTGRES_DB=resumer
POSTGRES_USER=resumer
POSTGRES_PASSWORD=resumer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@resumer.com
SERVER_EMAIL=server@resumer.com

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=resumer-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.resumer.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_TRIAL_PRICE_ID=price_your-trial-price-id

# --- OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# --- AI (OpenAI) ---
OPENAI_API_KEY=sk-your-openai-api-key

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Sentry ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# --- Security ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=False
FRONTEND_URL=http://localhost:3000

# --- Telegram ---
TELEGRAM_BOT_USERNAME=ResumerBot

# --- Admin (for create_superadmin command) ---
ADMIN_EMAIL=admin@resumer.com
ADMIN_PASSWORD=your-admin-password
