# ===========================================
# Resumer Frontend — Environment Variables
# ===========================================
# Copy this file to .env.local for local dev. The same values are baked into
# vercel.json so a one-click GitHub import "just works" on Vercel.

# ─── DEMO MODE (frontend-only deployment) ────────────────────────────────
# When true, a built-in mock API is used instead of a real backend. All
# data is stored in the user's browser (IndexedDB + localStorage). Pre-seeded
# demo accounts and resumes appear automatically on first visit.
NEXT_PUBLIC_DEMO_MODE=true

# --- API ---
# Demo mode ignores this — calls are intercepted before they leave the browser.
# When DEMO_MODE=false, point this at your real backend.
NEXT_PUBLIC_API_URL=/__demo__/api/v1

# WebSocket is disabled in demo mode.
NEXT_PUBLIC_WS_URL=

# Public site URL — Vercel sets this automatically after the first deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Resumer
NEXT_PUBLIC_APP_VERSION=2.7.0

# --- Stripe (hidden in demo mode) ---
NEXT_PUBLIC_STRIPE_KEY=

# --- OAuth (hidden in demo mode) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Optional ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_PAYMENTS=false

# --- i18n ---
NEXT_PUBLIC_DEFAULT_LOCALE=en-us

# --- Telegram Bot (docker-compose telegram-bot service) ---
BOT_TOKEN=
BOT_MODE=polling
API_BASE_URL=http://localhost:8000/api/v1
REDIS_URL=redis://localhost:6379/4
